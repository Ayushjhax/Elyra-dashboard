# Copy to .env.local and fill in. Every name here is read through lib/env.ts,
# which fails the boot rather than the first request when a required one is
# missing. Anything without a NEXT_PUBLIC_ prefix is server-only and must
# never be imported from a client component.

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------

# Required. The primary provider — every run is tried here first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Without it there is no fallback: an Anthropic outage becomes a
# failed run instead of a degraded one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Pyth Network — market prices
#
# The source of truth for every price in the product. One key covers both
# endpoints this app uses:
#
#   /v1/symbols       the feed catalogue (~3.7k instruments), fetched once
#                     every six hours and held server-side.
#   /v1/latest_price  batched current prices.
#
# Server only. The browser never sees this key: the client reads prices
# through /api/market/prices and searches assets through /api/market/assets,
# both of which run on the server and attach the key there.
#
# Without it the dashboard renders its error state and says prices are
# unavailable — it never falls back to an estimated or remembered price.
# ---------------------------------------------------------------------------

PYTH_API_KEY=

# Optional. Defaults to https://pyth.dourolabs.app. Override only to point at
# a different Pyth gateway.
PYTH_API_URL=

# ---------------------------------------------------------------------------
# Supabase
#
# The database only. Authentication is Privy, so auth.uid() is never populated
# and RLS is not what protects rows — see supabase/migrations. Every server
# query filters by user_id explicitly.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, never import in a client component. This key bypasses RLS
# entirely.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Privy — authentication
# ---------------------------------------------------------------------------

# Exactly 25 characters — the provider rejects any other length, and it does
# so during render, which fails the whole build rather than one page. The
# startup check catches it first and says so.
NEXT_PUBLIC_PRIVY_APP_ID=

# Server only. Used to construct the server client that verifies access tokens.
PRIVY_APP_SECRET=

# Optional. The JWT verification key from the Privy dashboard, in SPKI PEM
# form. When set, token verification is local; when absent, the SDK fetches
# the app's JWKS instead, which costs a network round trip on cold start.
PRIVY_VERIFICATION_KEY=

# ---------------------------------------------------------------------------
# Exchange credential encryption
#
# AES-256-GCM key for the api_key_enc / api_secret_enc / passphrase_enc
# columns in exchange_accounts. Must decode to exactly 32 bytes.
#
#   openssl rand -base64 32
#
# Rotating this key makes every stored credential undecryptable. There is no
# re-wrap path in this pass, so users would have to reconnect their exchanges.
# ---------------------------------------------------------------------------

CREDENTIALS_ENC_KEY=

# ---------------------------------------------------------------------------
# Telegram
#
# All three are optional together. Without them the webhook and link routes
# return 503 and the rest of the app is unaffected.
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=

# Without the @, e.g. elyra_terminal_bot. Used to build the t.me deep link.
TELEGRAM_BOT_USERNAME=

# Random, 32+ characters. Matched against the X-Telegram-Bot-Api-Secret-Token
# header on every webhook call; a mismatch is a 401 with no body.
#
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Market data cache
#
# Optional. Without them, cache reads and writes fall back to the market_cache
# table, which is slower but correct.
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Limits and origin
# ---------------------------------------------------------------------------

# Agent runs per user per UTC day. Defaults to 100.
AGENT_MAX_RUNS_PER_DAY=100

# Absolute origin, no trailing slash. Used for the Telegram webhook
# registration and the deep link. Defaults to http://localhost:3000.
APP_URL=

# ---------------------------------------------------------------------------
# Solana RPC — wallet balances and transaction history
#
# Server only. The browser never sees this URL: the wallet dashboard reads
# through /api/wallet and /api/wallet/activity, both of which run on the
# server and attach it there. A URL in client code is a URL anyone can drain
# your quota with.
#
# Three methods are called, all read-only:
#
#   getBalance                 native SOL, in lamports
#   getTokenAccountsByOwner    SPL balances, jsonParsed
#   getSignaturesForAddress    recent transaction history
#
# Use a paid endpoint (Helius, QuickNode, Triton). The public
# api.mainnet-beta.solana.com is rate-limited hard enough that a 30s poll
# from a handful of tabs will start returning 429, and there is deliberately
# no fallback to it: a silent downgrade to an endpoint that fails half the
# time is worse than an error that says what is wrong.
#
# Without it the wallet surfaces report that the RPC is unconfigured and the
# health meter reads it as degraded. Nothing else in the app is affected.
# ---------------------------------------------------------------------------

SOLANA_RPC_URL=
