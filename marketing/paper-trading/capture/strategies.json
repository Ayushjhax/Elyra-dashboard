[{"id":"BOLLINGER_MEAN_REVERSION_V1","name":"Bollinger Bands — mean reversion","category":"mean_reversion","rules":{"entry":"Price closes below the lower band, then closes back above it. The re-entry is the signal, not the initial breach — a price outside the band can stay outside for a long time.","exit":"Close crosses above the middle band (the 20-period SMA)."},"parameters":[{"key":"period","label":"Period","default":20,"min":2,"max":200,"description":"SMA length for the middle band."},{"key":"multiplier","label":"Std deviations","default":2,"min":0.5,"max":5,"step":0.1,"description":"Band width."}],"intradayOnly":false},{"id":"BOLLINGER_BREAKOUT_V1","name":"Bollinger Bands — breakout","category":"volatility","rules":{"entry":"Close crosses above the upper band.","exit":"Close crosses below the middle band."},"parameters":[{"key":"period","label":"Period","default":20,"min":2,"max":200,"description":"SMA length."},{"key":"multiplier","label":"Std deviations","default":2,"min":0.5,"max":5,"step":0.1,"description":"Band width."}],"intradayOnly":false},{"id":"RSI_12_MEAN_REVERSION_V1","name":"RSI (12) — mean reversion","category":"mean_reversion","rules":{"entry":"RSI crosses back ABOVE the oversold level. Entering while RSI is still falling through oversold catches a knife; the cross back up is the earliest confirmation the condition is resolving.","exit":"RSI crosses above the exit level (default 50, the midpoint)."},"parameters":[{"key":"period","label":"RSI period","default":12,"min":2,"max":100,"description":"Wilder smoothing length."},{"key":"oversold","label":"Oversold","default":30,"min":1,"max":49,"description":"Entry trigger level."},{"key":"exitLevel","label":"Exit level","default":50,"min":2,"max":99,"description":"Exit when RSI crosses above this."}],"intradayOnly":false},{"id":"STOCHASTIC_CROSS_V1","name":"Stochastic — oversold cross","category":"mean_reversion","rules":{"entry":"%K crosses above %D while %K is at or below the oversold level.","exit":"%K crosses below %D while %K is at or above the overbought level."},"parameters":[{"key":"period","label":"%K period","default":14,"min":2,"max":100,"description":"Lookback."},{"key":"smoothK","label":"%K smoothing","default":3,"min":1,"max":20,"description":"Slow %K smoothing."},{"key":"smoothD","label":"%D smoothing","default":3,"min":1,"max":20,"description":"Signal smoothing."},{"key":"oversold","label":"Oversold","default":20,"min":1,"max":49,"description":"Entry zone ceiling."},{"key":"overbought","label":"Overbought","default":80,"min":51,"max":99,"description":"Exit zone floor."}],"intradayOnly":false},{"id":"WILLIAMS_R_REVERSION_V1","name":"Williams %R — reversion","category":"mean_reversion","rules":{"entry":"%R crosses back above the oversold level (default −80).","exit":"%R crosses above the exit level (default −50)."},"parameters":[{"key":"period","label":"Period","default":14,"min":2,"max":100,"description":"Lookback."},{"key":"oversold","label":"Oversold","default":-80,"min":-99,"max":-51,"description":"Entry trigger."},{"key":"exitLevel","label":"Exit level","default":-50,"min":-99,"max":-1,"description":"Exit trigger."}],"intradayOnly":false},{"id":"MACD_CROSS_V1","name":"MACD — signal cross","category":"momentum","rules":{"entry":"MACD line crosses above the signal line.","exit":"MACD line crosses below the signal line."},"parameters":[{"key":"fast","label":"Fast EMA","default":12,"min":2,"max":100,"description":"Fast length."},{"key":"slow","label":"Slow EMA","default":26,"min":3,"max":200,"description":"Slow length."},{"key":"signal","label":"Signal EMA","default":9,"min":2,"max":50,"description":"Signal length."},{"key":"requireAboveZero","label":"Require MACD > 0","default":0,"min":0,"max":1,"step":1,"description":"1 to only enter above zero."}],"intradayOnly":false},{"id":"AWESOME_OSCILLATOR_V1","name":"Awesome Oscillator — zero cross","category":"momentum","rules":{"entry":"AO crosses above zero.","exit":"AO crosses below zero."},"parameters":[{"key":"fast","label":"Fast SMA","default":5,"min":2,"max":50,"description":"Median-price fast length."},{"key":"slow","label":"Slow SMA","default":34,"min":3,"max":200,"description":"Median-price slow length."}],"intradayOnly":false},{"id":"APO_ZERO_CROSS_V1","name":"Absolute Price Oscillator — zero cross","category":"momentum","rules":{"entry":"APO crosses above zero.","exit":"APO crosses below zero."},"parameters":[{"key":"fast","label":"Fast EMA","default":12,"min":2,"max":100,"description":"Fast length."},{"key":"slow","label":"Slow EMA","default":26,"min":3,"max":200,"description":"Slow length."}],"intradayOnly":false},{"id":"BALANCE_OF_POWER_V1","name":"Balance of Power — zero cross","category":"momentum","rules":{"entry":"Smoothed BOP crosses above zero.","exit":"Smoothed BOP crosses below zero."},"parameters":[{"key":"period","label":"Smoothing","default":14,"min":1,"max":100,"description":"SMA length."}],"intradayOnly":false},{"id":"ICHIMOKU_CLOUD_V1","name":"Ichimoku Cloud — Tenkan/Kijun above cloud","category":"trend","rules":{"entry":"Tenkan crosses above Kijun while the close is above both cloud spans. The cloud value at each bar was computed 26 bars earlier, so no future data is read.","exit":"Tenkan crosses below Kijun, or the close falls below the cloud."},"parameters":[{"key":"tenkan","label":"Tenkan","default":9,"min":2,"max":100,"description":"Conversion line."},{"key":"kijun","label":"Kijun","default":26,"min":2,"max":200,"description":"Base line."},{"key":"senkouB","label":"Senkou B","default":52,"min":2,"max":400,"description":"Leading span B."},{"key":"displacement","label":"Displacement","default":26,"min":1,"max":100,"description":"Cloud forward shift."}],"intradayOnly":false},{"id":"PARABOLIC_SAR_V1","name":"Parabolic SAR — trend flip","category":"trend","rules":{"entry":"SAR flips bullish (price closes above the SAR after being below).","exit":"SAR flips bearish."},"parameters":[{"key":"step","label":"Step","default":0.02,"min":0.001,"max":0.2,"step":0.001,"description":"Acceleration increment."},{"key":"max","label":"Max step","default":0.2,"min":0.01,"max":1,"step":0.01,"description":"Acceleration ceiling."}],"intradayOnly":false},{"id":"AROON_CROSS_V1","name":"Aroon — trend cross","category":"trend","rules":{"entry":"Aroon Up crosses above Aroon Down, with Up above the confirmation level and Down below it.","exit":"Aroon Down crosses above Aroon Up."},"parameters":[{"key":"period","label":"Period","default":25,"min":2,"max":200,"description":"Lookback."},{"key":"upThreshold","label":"Up confirmation","default":70,"min":0,"max":100,"description":"Up must exceed this."},{"key":"downThreshold","label":"Down confirmation","default":30,"min":0,"max":100,"description":"Down must be below this."}],"intradayOnly":false},{"id":"VORTEX_CROSS_V1","name":"Vortex — VI+ / VI− cross","category":"trend","rules":{"entry":"VI+ crosses above VI−.","exit":"VI+ crosses below VI−."},"parameters":[{"key":"period","label":"Period","default":14,"min":2,"max":100,"description":"Lookback."}],"intradayOnly":false},{"id":"TYPICAL_PRICE_MA_CROSS_V1","name":"Typical Price — EMA cross","category":"trend","rules":{"entry":"Typical price (H+L+C)/3 crosses above its EMA.","exit":"Typical price crosses below its EMA."},"parameters":[{"key":"period","label":"EMA period","default":20,"min":2,"max":200,"description":"EMA length."}],"intradayOnly":false},{"id":"CHAIKIN_MONEY_FLOW_V1","name":"Chaikin Money Flow — zero cross","category":"volume","rules":{"entry":"CMF crosses above the threshold (default 0).","exit":"CMF crosses below the negative threshold."},"parameters":[{"key":"period","label":"Period","default":20,"min":2,"max":100,"description":"Lookback."},{"key":"threshold","label":"Threshold","default":0,"min":0,"max":0.5,"step":0.01,"description":"Use 0.05 for a stricter filter."}],"intradayOnly":false},{"id":"MFI_REVERSION_V1","name":"Money Flow Index — reversion","category":"volume","rules":{"entry":"MFI crosses back above the oversold level.","exit":"MFI crosses above the exit level."},"parameters":[{"key":"period","label":"Period","default":14,"min":2,"max":100,"description":"Lookback."},{"key":"oversold","label":"Oversold","default":20,"min":1,"max":49,"description":"Entry trigger."},{"key":"exitLevel","label":"Exit level","default":80,"min":51,"max":99,"description":"Exit trigger."}],"intradayOnly":false},{"id":"FORCE_INDEX_V1","name":"Force Index — zero cross","category":"volume","rules":{"entry":"EMA-smoothed Force Index crosses above zero.","exit":"Smoothed Force Index crosses below zero."},"parameters":[{"key":"period","label":"EMA smoothing","default":13,"min":2,"max":100,"description":"Smoothing length."}],"intradayOnly":false},{"id":"EASE_OF_MOVEMENT_V1","name":"Ease of Movement — zero cross","category":"volume","rules":{"entry":"Smoothed EOM crosses above zero.","exit":"Smoothed EOM crosses below zero."},"parameters":[{"key":"period","label":"Smoothing","default":14,"min":2,"max":100,"description":"SMA length."}],"intradayOnly":false},{"id":"NVI_TREND_V1","name":"Negative Volume Index — EMA trend","category":"volume","rules":{"entry":"NVI crosses above its long EMA (default 255).","exit":"NVI crosses below its EMA."},"parameters":[{"key":"period","label":"EMA period","default":255,"min":10,"max":500,"description":"Signal EMA length."}],"intradayOnly":false},{"id":"SESSION_VWAP_RECLAIM_V1","name":"Session VWAP — reclaim","category":"price_volume","rules":{"entry":"Close crosses above the session VWAP, which resets each UTC day.","exit":"Close crosses below the session VWAP."},"parameters":[],"intradayOnly":true},{"id":"VWMA_CROSS_V1","name":"VWMA — price cross","category":"price_volume","rules":{"entry":"Close crosses above the volume-weighted moving average.","exit":"Close crosses below the VWMA."},"parameters":[{"key":"period","label":"Period","default":20,"min":2,"max":200,"description":"VWMA length."}],"intradayOnly":false}]