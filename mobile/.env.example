# Public values only — every EXPO_PUBLIC_ variable is inlined into the app
# bundle, so nothing secret may ever go here.

# Elyra's API. Production: https://api.getelyra.xyz
# Android emulator against a local `pnpm dev`: http://10.0.2.2:3000
# A phone on USB (after `adb reverse tcp:3000 tcp:3000`): http://localhost:3000
# A phone on the same Wi-Fi: http://<your Mac's IP>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Privy — the same app as the website, so a person keeps one account and one
# embedded wallet. The app ID is public (the website ships it too). The client
# ID comes from Privy dashboard → your app → Settings → Clients → the Android
# client for xyz.getelyra.app.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Crash reporting (src/lib/crash, docs/RELEASE.md). Leave unset to keep it
# off; set only once the published privacy policy names Sentry. A DSN can
# only send events, so it is a public value. Development builds never send.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only, never EXPO_PUBLIC_ (EAS environment variables): which
# Sentry project receives the source maps. SENTRY_AUTH_TOKEN is a secret —
# set it in EAS, not here; without it the build skips the upload.
# SENTRY_ORG=
# SENTRY_PROJECT=
