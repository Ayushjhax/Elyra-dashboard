{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "pnpm": "10.19.0"
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "pnpm": "10.19.0"
    },
    "dapp-store": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "pnpm": "10.19.0"
    }
  }
}
