      "^~/(.*)$": "<rootDir>/src/$1",
      "^@/(.*)$": "<rootDir>/../$1"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
