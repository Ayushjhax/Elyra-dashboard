  "scripts": {
    "start": "expo start --dev-client",
    "phone": "${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb reverse tcp:8081 tcp:8081 && ${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb reverse tcp:3000 tcp:3000 && expo start --dev-client",
